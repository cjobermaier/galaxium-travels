{
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trust Boundary Audit",
          "version": "1.0.0",
          "informationUri": "https://owasp.org/www-project-application-security-verification-standard/",
          "rules": [
            {
              "id": "ASVS-V5.1.2",
              "name": "MassParameterAssignment",
              "shortDescription": {
                "text": "The framework or code protects against mass parameter assignment."
              },
              "fullDescription": {
                "text": "OWASP ASVS 4.0 V5.1.2: Verify that the framework protects against mass parameter assignment attacks, or that the application has countermeasures to protect against unsafe parameter assignment."
              },
              "helpUri": "https://owasp.org/www-project-application-security-verification-standard/",
              "properties": {
                "tags": ["security", "input-validation"]
              }
            },
            {
              "id": "ASVS-V5.1.3",
              "name": "InputAllowListValidation",
              "shortDescription": {
                "text": "All input is validated against an allow list of expected fields and values."
              },
              "fullDescription": {
                "text": "OWASP ASVS 4.0 V5.1.3: Verify that all input (HTML form fields, REST requests, URL parameters, HTTP headers, cookies, batch files, RSS feeds, etc) is validated using positive validation (allow lists)."
              },
              "helpUri": "https://owasp.org/www-project-application-security-verification-standard/",
              "properties": {
                "tags": ["security", "input-validation"]
              }
            },
            {
              "id": "ASVS-V11.1.4",
              "name": "ExcessiveBusinessRequestLimits",
              "shortDescription": {
                "text": "The application limits excessive business requests, such as one user holding too much inventory."
              },
              "fullDescription": {
                "text": "OWASP ASVS 4.0 V11.1.4: Verify that the application has anti-automation controls to protect against excessive calls such as mass data exfiltration, business logic requests, file uploads or denial of service attacks."
              },
              "helpUri": "https://owasp.org/www-project-application-security-verification-standard/",
              "properties": {
                "tags": ["security", "business-logic"]
              }
            },
            {
              "id": "ASVS-V11.1.5",
              "name": "BusinessLogicPriceAbuseLimits",
              "shortDescription": {
                "text": "The application has business logic limits that protect against likely abuse, such as a client setting its own price."
              },
              "fullDescription": {
                "text": "OWASP ASVS 4.0 V11.1.5: Verify the application has business logic limits or validation to protect against likely business risks or threats, identified using threat modeling or similar methodologies."
              },
              "helpUri": "https://owasp.org/www-project-application-security-verification-standard/",
              "properties": {
                "tags": ["security", "business-logic"]
              }
            }
          ]
        }
      },
      "artifacts": [
        {
          "location": {
            "uri": "booking_system_backend/server.py",
            "uriBaseId": "%SRCROOT%"
          }
        },
        {
          "location": {
            "uri": "booking_system_backend/schemas.py",
            "uriBaseId": "%SRCROOT%"
          }
        },
        {
          "location": {
            "uri": "booking_system_backend/services/itinerary.py",
            "uriBaseId": "%SRCROOT%"
          }
        }
      ],
      "results": [
        {
          "ruleId": "ASVS-V5.1.2",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "F-1: create_booking_from_hold accepts the request body as dict — no schema enforces the exact allowed fields, exposing a mass assignment surface. Fix: Replace the dict parameter with a typed Pydantic model (e.g. HoldCallbackRequest) that declares exactly the four expected fields: travelerId, travelerName, flightId, and seatClass."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "booking_system_backend/server.py",
                  "uriBaseId": "%SRCROOT%",
                  "index": 0
                },
                "region": {
                  "startLine": 286,
                  "startColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "create_booking_from_hold",
                  "kind": "function"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "ASVS-V5.1.3",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "F-2: CreateItineraryRequest.name is declared as plain str with no min_length, max_length, or character-set constraint; an arbitrarily large or specially crafted string is forwarded verbatim into the Java quote payload and into error messages. Fix: Add Field(min_length=1, max_length=120) (or an equivalent Annotated[str, StringConstraints(...)]) to CreateItineraryRequest.name."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "booking_system_backend/schemas.py",
                  "uriBaseId": "%SRCROOT%",
                  "index": 1
                },
                "region": {
                  "startLine": 109,
                  "startColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "CreateItineraryRequest",
                  "kind": "type"
                }
              ]
            }
          ]
        },
        {
          "ruleId": "ASVS-V5.1.3",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "F-3 (also V11.1.5): hold_data[\"seatClass\"] is read from the caller's JSON and passed to book_flight with no validation against the allowed literal set ('economy' | 'business' | 'galaxium'). A caller that can reach this endpoint can supply \"galaxium\" and obtain a premium booking at economy price. Fix: Declare seat_class: SeatClass on the typed Pydantic model introduced for F-1 so Pydantic rejects any value outside the allowed set automatically."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "booking_system_backend/server.py",
                  "uriBaseId": "%SRCROOT%",
                  "index": 0
                },
                "region": {
                  "startLine": 297,
                  "startColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "create_booking_from_hold",
                  "kind": "function"
                }
              ]
            }
          ],
          "relatedLocations": [
            {
              "id": 1,
              "message": {
                "text": "V11.1.5 co-violation: client-supplied seat class bypasses price enforcement"
              },
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "booking_system_backend/server.py",
                  "uriBaseId": "%SRCROOT%",
                  "index": 0
                },
                "region": {
                  "startLine": 297,
                  "startColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "ASVS-V11.1.4",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "F-4: create_itinerary places a Java inventory hold for each requested flight without checking how many itineraries the same user_id already has in \"held\" status; a single user can hold an unlimited number of seats across the entire inventory. Fix: Before placing any holds, query the Itinerary table for rows where user_id matches AND status == \"held\" and return a TOO_MANY_HOLDS error if the count meets or exceeds a configurable threshold (e.g. 5)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "booking_system_backend/services/itinerary.py",
                  "uriBaseId": "%SRCROOT%",
                  "index": 2
                },
                "region": {
                  "startLine": 50,
                  "startColumn": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "create_itinerary",
                  "kind": "function"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
